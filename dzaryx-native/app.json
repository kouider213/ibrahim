{
  "expo": {
    "name": "Dzaryx",
    "slug": "dzaryx",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": ["assets/**"],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dzaryx.app",
      "versionCode": 16,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "foregroundService": {
        "notificationTitle": "🤖 Dzaryx — Wake word actif",
        "notificationBody": "Dis \"Jarvis\" pour activer",
        "notificationColor": "#00d4ff"
      }
    },
    "ios": {
      "bundleIdentifier": "com.dzaryx.app",
      "buildNumber": "16",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Dzaryx utilise le micro pour t'écouter et détecter le wake word.",
        "NSCameraUsageDescription": "Dzaryx utilise la caméra pour analyser ce que tu vois.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Orbitron-Regular.ttf",
            "./assets/fonts/Orbitron-Bold.ttf",
            "./assets/fonts/Exo2-Regular.ttf",
            "./assets/fonts/Exo2-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dzaryx utilise la caméra pour analyser ce que tu vois."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Dzaryx utilise le micro pour t'écouter."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0a0a0a",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Dzaryx utilise ta position pour calculer le temps de trajet réel.",
          "locationWhenInUsePermission": "Dzaryx utilise ta position pour calculer le temps de trajet réel."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dzaryx accède à ta galerie pour scanner des documents.",
          "cameraPermission": "Dzaryx utilise la caméra pour scanner des documents."
        }
      ],
      "expo-local-authentication",
      "expo-quick-actions",
      "./plugins/withWakeScreen.js"
    ],
    "scheme": "dzaryx",
    "owner": "fikkouider",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca9eb26d-6235-4d3c-8720-1371ccf12a65"
      }
    }
  }
}
